package main

import (
    "fmt"
)

func Signe() {
    var n int
    fmt.Print("Donner un nombre: ")
    fmt.Scan(&n)
    if n < 0 {
        fmt.Print("Le signe est négatif (-)")
    } else if n > 0 {
        fmt.Print("Le signe est positif (+)")
    } else if n == 0 {
        fmt.Print("Le signe est null (positif et négatif)")
    }
}

func main() {
    Signe()
}
